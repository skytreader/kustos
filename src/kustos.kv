BoxLayout:
    orientation: "vertical"
    GridLayout:
        size_hint: (1, 0.2)
        cols: 3
        row_force_default: True
        row_default_height: 42
        Label:
            text: "Source Dir"
        TextInput:
            multiline: False
        Button:
            text: "Browse"
        Label:
            text: "Destination Dir"
        TextInput:
            multiline: False
        Button:
            text: "Browse"
    GridLayout:
        cols: 2
        size_hint: (1, None)
        row_force_default: True
        row_default_height: 42
        Button:
            text: "Copy"
            on_press: app.next_image
        Button:
            text: "Pass"
    Image:
        size_hint: (1, 0.7)
        id: main_img
