BoxLayout:
    orientation: "vertical"
    GridLayout:
        size_hint: (1, 0.2)
        cols: 3
        row_force_default: True
        row_default_height: 42
        Label:
            text: "Source Dir"
        TextInput:
            multiline: False
        Button:
            text: "Browse"
            on_release: app.show_load()
        Label:
            text: "Destination Dir"
        TextInput:
            multiline: False
        Button:
            text: "Browse"
    GridLayout:
        cols: 2
        size_hint: (1, None)
        row_force_default: True
        row_default_height: 42
        Button:
            text: "Copy"
            on_release: app.next_image()
        Button:
            text: "Pass"
    Image:
        size_hint: (1, 0.7)
        id: main_img

<LoadDialog>:
    BoxLayout:
        size: root.size
        pos: root.pos
        orientation: "vertical"
        Label:
            size_hint: (None, 0.1)
            text: root.rootpath
        FileChooserListView:
            id: filechooser
            rootpath: root.rootpath

        BoxLayout:
            size_hint_y: None
            height: 30
            Button:
                text: "Cancel"
                on_release: app.close_popup()

            Button:
                text: "Load"
                on_release: app.callback_load(filechooser.path, filechooser.selection)
